# Copy to .env.local (git-ignored) and fill in. None of these reach the app bundle.

# One Google Cloud key with "YouTube Data API v3" and "Places API (New)" enabled.
GOOGLE_API_KEY=
# Or separate keys, which win over GOOGLE_API_KEY:
# YOUTUBE_API_KEY=
# PLACES_API_KEY=

# From Google AI Studio. The free tier is enough for testing.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Google photos use a free allowance of 1,000 a month. "off" skips them.
# PLACES_PHOTOS=off

# Protection and storage (supabase/api.sql). Without the secret key the API runs open, which it
# only allows outside production. The URL is the same public one the app uses.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Limits (defaults shown). The daily caps sit under Google's free monthly allowances.
# LIMIT_EXTRACT_PER_HOUR=20
# LIMIT_MATCH_PER_HOUR=300
# LIMIT_PLACE_DETAILS_PER_DAY=300
# LIMIT_PHOTOS_PER_DAY=30

# Instagram reels, read through Apify (apify.com > Settings > API & Integrations). Optional: without
# it, Instagram links go straight to adding places by search. The free plan's $5 a month is enough.
# APIFY_TOKEN=
# INSTAGRAM_TRANSCRIPTS=off
# LIMIT_INSTAGRAM_REELS_PER_DAY=20
# LIMIT_INSTAGRAM_TRANSCRIPTS_PER_DAY=1

# The web map for real cities (Maps JavaScript API). This key is in the web page by design, so in
# Google Cloud restrict it to Websites (localhost and your Expo hosting address) and to the Maps
# JavaScript API only. Keep it separate from the Places key. The map ID (Map Management, JavaScript,
# Vector) lets pins be the app's photo pins; without one, Google's DEMO_MAP_ID is used.
# EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# EXPO_PUBLIC_GOOGLE_MAP_ID=
