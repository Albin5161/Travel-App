{
  "expo": {
    "name": "Xplore",
    "slug": "xplore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xplore",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F4F1",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4F1",
          "image": "./assets/images/splash-icon-ink.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xplore uses your location to show how far your saved spots are from you.",
          "locationAlwaysAndWhenInUsePermission": "Xplore checks when you arrive in a district you've saved spots in, so it can remind you they're nearby.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E2763C"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "caadf92f-45b8-4cfb-bb5f-a78f0f9adb0f"
      }
    },
    "owner": "albin5161"
  }
}
